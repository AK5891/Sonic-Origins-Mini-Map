<Window x:Class="Sonic_Tracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sonic Tracker"
        Icon="/Assets/Images/AppIcon.png"
        Width="1100"
        Height="650"
        MinWidth="700"
        MinHeight="400"
        Background="#181818">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,10"
                Padding="10"
                Background="#252525"
                CornerRadius="6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="/Assets/Images/SonicOriginsLogo.png"
                       Width="140"
                       Height="35"
                       Margin="0,0,10,0"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <TextBlock Grid.Column="1"
                           x:Name="ConnectionText"
                           Text="Waiting for Sonic Origins..."
                           Foreground="White"
                           FontSize="16"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <Button Grid.Column="2"
                        x:Name="NativeAudioTestButton"
                        Content="Start Live Recognition"
                        Width="180"
                        Height="35"
                        Margin="10,0,0,0"
                        Click="NativeAudioTestButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="8"
                Background="#101010"
                BorderBrush="#404040"
                BorderThickness="1"
                CornerRadius="6">

            <Grid x:Name="MapViewport"
                  Background="Black"
                  ClipToBounds="True"
                  SizeChanged="MapViewport_SizeChanged"
                  PreviewMouseWheel="MapViewport_PreviewMouseWheel"
                  MouseLeftButtonDown="MapViewport_MouseLeftButtonDown"
                  MouseLeftButtonUp="MapViewport_MouseLeftButtonUp"
                  MouseMove="MapViewport_MouseMove">
                <Canvas x:Name="LevelCanvas"
                        Background="Black"
                        ClipToBounds="True"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        RenderTransformOrigin="0,0">

                    <Image x:Name="LevelMapImage"
                           Canvas.Left="0"
                           Canvas.Top="0"
                           Stretch="Fill"/>

                    <Canvas x:Name="BigRingOverlayCanvas"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            IsHitTestVisible="False"
                            Visibility="{Binding Visibility, ElementName=LevelMapImage}"/>

                    <Canvas x:Name="SonicCDObjectOverlayCanvas"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            IsHitTestVisible="False"
                            Visibility="{Binding Visibility, ElementName=LevelMapImage}"/>

                    <Image x:Name="SonicMarker"
                           Width="64"
                           Height="64"
                           Stretch="Uniform"
                           RenderTransformOrigin="0.5,0.5"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           IsHitTestVisible="False">
                        <Image.RenderTransform>
                            <ScaleTransform x:Name="CharacterMarkerScaleTransform"/>
                        </Image.RenderTransform>
                    </Image>
                </Canvas>

                <Border x:Name="TrackStateOverlay"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Padding="24,16"
                        Background="#DD101010"
                        BorderBrush="#CCFFFFFF"
                        BorderThickness="1"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <StackPanel>
                        <Image x:Name="TrackStateLogoImage"
                               MaxWidth="360"
                               MaxHeight="180"
                               Margin="0,0,0,14"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed"/>

                        <TextBlock x:Name="TrackStateTitleText"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   TextAlignment="Center"/>

                        <TextBlock x:Name="TrackStateDetailText"
                                   Margin="0,6,0,0"
                                   Foreground="#DDFFFFFF"
                                   FontSize="15"
                                   TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Padding="6"
                        Background="#CC252525"
                        CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="−"
                                Width="36"
                                Height="30"
                                FontSize="18"
                                ToolTip="Zoom out"
                                Click="ZoomOutButton_Click"/>

                        <Button Content="+"
                                Width="36"
                                Height="30"
                                Margin="5,0,0,0"
                                FontSize="18"
                                ToolTip="Zoom in"
                                Click="ZoomInButton_Click"/>

                        <Button Content="Recenter"
                                Width="82"
                                Height="30"
                                Margin="5,0,0,0"
                                ToolTip="Restore the default zoom and center on Sonic"
                                Click="RecenterCameraButton_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                Background="#252525"
                CornerRadius="6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           x:Name="PositionText"
                           Text="Zone: --&#10;X: --&#10;Y: --"
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Left"/>

                <TextBlock Grid.Column="1"
                           x:Name="AudioStatusText"
                           Text="Audio recognition stopped."
                           Foreground="White"
                           FontFamily="Consolas"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Left"
                           TextWrapping="Wrap"/>

                <StackPanel Grid.Column="2"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Manual map override"
                               Margin="0,0,0,4"
                               Foreground="White"
                               FontSize="13"/>

                    <ComboBox x:Name="MapOverrideComboBox"
                              Width="220"
                              DisplayMemberPath="DisplayName"/>

                    <StackPanel Margin="0,6,0,0"
                                Orientation="Horizontal">
                        <Button Content="Apply"
                                Width="105"
                                Margin="0,0,5,0"
                                Click="ApplyMapOverrideButton_Click"/>

                        <Button Content="Auto"
                                Width="105"
                                Click="ClearMapOverrideButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
